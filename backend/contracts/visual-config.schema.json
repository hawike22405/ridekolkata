{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "modelUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "modelScale": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100
        },
        "modelRotationQuaternion": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "lightingIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "cameraPivotPoints": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "rotationQuaternion": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                ],
                "items": false,
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "position",
              "rotationQuaternion"
            ],
            "additionalProperties": false
          }
        },
        "cameraFov": {
          "type": "number",
          "minimum": 10,
          "maximum": 120
        },
        "drivetrainAnimationSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "hexColors": {
          "type": "object",
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "background",
            "primary",
            "accent"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "modelUrl",
        "modelScale",
        "modelRotationQuaternion",
        "lightingIntensity",
        "cameraPivotPoints",
        "cameraFov",
        "drivetrainAnimationSpeed",
        "hexColors"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "data",
    "revision",
    "updatedAt"
  ],
  "additionalProperties": false,
  "description": "Ride Kolkata visual configuration response, version 1. The executable Zod contract additionally enforces unit-length quaternions and safe model URLs."
}
