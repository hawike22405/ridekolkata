NODE_ENV=production
PORT=3001
# Same exact HTTPS origin as the web process PUBLIC_ORIGIN.
ALLOWED_ORIGIN=
# Configure for your actual trusted proxy topology; API must not be publicly bypassable.
TRUST_PROXY_HOPS=1
MONGODB_URI=
# Distinct cryptographically random secrets of at least 64 characters each.
JWT_SECRET=
TELEMETRY_JWT_SECRET=
